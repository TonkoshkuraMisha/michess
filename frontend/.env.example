# --- FILE: frontend/.env.example ---
# Адреса бэкенда для разработки (npm run dev). Если не заданы — http://127.0.0.1:8000.
# В продакшен-сборке (frontend/Dockerfile) их не задают: API и WebSocket берутся с того же
# домена, что и страница.
VITE_API_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000
