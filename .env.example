# --- FILE: .env.example ---
# Скопируйте в .env и заполните. Для разработки значения ниже совпадают с docker-compose.yml.
# Для продакшена (docker-compose.prod.yml) обязательно смените пароль БД и SECRET_KEY.

# development | production. В production приложение не стартует со слабым SECRET_KEY
# и не публикует /docs.
ENVIRONMENT=development

# PostgreSQL. В продакшене POSTGRES_SERVER/PORT задаёт docker-compose.prod.yml (db:5432).
POSTGRES_USER=michess_user
POSTGRES_PASSWORD=michess_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=michess_db

# Redis. В продакшене задаёт docker-compose.prod.yml (redis:6379).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Подпись токенов. Для продакшена — случайная строка не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key

# Разрешённые источники CORS через запятую. В продакшене фронтенд и API на одном домене —
# можно оставить пустым.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Только docker-compose.prod.yml ---
# Внешний порт nginx, число процессов uvicorn и Celery.
HTTP_PORT=80
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
