# --- FILE: .env.example ---
# Скопируйте в .env и заполните. Для разработки значения ниже совпадают с docker-compose.yml.
# Для продакшена (docker-compose.prod.yml) обязательно смените пароль БД и SECRET_KEY.

# development | production. В production приложение не стартует со слабым SECRET_KEY
# и не публикует /docs.
ENVIRONMENT=development

# PostgreSQL. В продакшене POSTGRES_SERVER/PORT задаёт docker-compose.prod.yml (db:5432).
POSTGRES_USER=regence_user
POSTGRES_PASSWORD=regence_password
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=regence_db

# Redis. В продакшене задаёт docker-compose.prod.yml (redis:6379).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Подпись токенов. Для продакшена — случайная строка не короче 32 символов:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-secret-key

# Разрешённые источники CORS через запятую. В продакшене фронтенд и API на одном домене —
# можно оставить пустым.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Наблюдаемость. Sentry выключен, пока SENTRY_DSN пуст. Доля запросов с трассировкой
# производительности (0.0–1.0): 0 — только ошибки.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Порт /metrics воркера Celery (время движка в фоновом разборе и симуляциях); 0 — выключено. В продакшене его
# задаёт docker-compose.prod.yml для сервисов worker и worker-simulation — здесь не нужен.
WORKER_METRICS_PORT=0

# --- Только docker-compose.prod.yml ---
# Внешний порт nginx, число процессов uvicorn и Celery.
HTTP_PORT=80
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2
# Предел CPU воркера анализа (ядер): анализ партий не должен отнимать CPU у API.
WORKER_CPUS=1.0
# Воркер партий ботов в турнирах (отдельная очередь simulation): сколько партий одновременно и предел CPU.
SIMULATION_CONCURRENCY=1
SIMULATION_CPUS=0.5

# Почта (подтверждение e-mail и сброс пароля). Пустой SMTP_HOST — письма не отправляются, а пишутся в лог
# (разработка). Любой провайдер транзакционной почты (Brevo, Amazon SES, Postmark…) — только эти переменные.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=regence <noreply@example.com>
# Адрес сайта для ссылок в письмах.
PUBLIC_BASE_URL=http://localhost:5173

# Программа беты. REGISTRATION_INVITE_ONLY=true — регистрация только по коду-приглашению (коды создаёт модератор на
# странице /moderation); по умолчанию регистрация открыта. COMMUNITY_URL — ссылка на канал сообщества, например
# https://t.me/<адрес канала>: пусто — ссылка на сайте не показывается.
REGISTRATION_INVITE_ONLY=false
# Согласие с правилами сообщества и конфиденциальностью при регистрации (таск 23.1): без отметки — отказ.
REQUIRE_TERMS_CONSENT=true
COMMUNITY_URL=https://t.me/regence_club

# Арены и конференции (DEPLOY.md, раздел 8д). ARENA_CONFERENCES — конференции, по расписанию которых создаются
# арены: пока игроков мало, список можно сократить (например, central). COUNTRY_HEADER — заголовок прокси со страной
# посетителя (например, CF-IPCountry): страна из него только предлагается игроку и не сохраняется; пусто — подсказки
# по адресу нет.
ARENA_CONFERENCES=central,western,northern,southern,eastern
COUNTRY_HEADER=

# Резервные копии БД (сервис backup): папка на хосте, интервал снимков и срок хранения.
# Копируйте содержимое BACKUP_DIR за пределы сервера — бэкап на том же диске не спасёт от его потери.
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14
# Проверка восстановления последнего снимка раз в N суток (0 — выключено) и вебхук для оповещения о сбое
# снимка или проверки (POST с текстом; пусто — только строка ERROR в журнале сервиса backup).
BACKUP_VERIFY_EVERY_DAYS=7
BACKUP_ALERT_WEBHOOK_URL=
# Копия снимков вне сервера (профиль offsite, DEPLOY раздел 5): удалённое хранилище rclone `offsite`
# и путь в нём. Пример для S3-совместимого хранилища — раскомментировать и заполнить.
# BACKUP_OFFSITE_PATH=offsite:regence-backups
# BACKUP_OFFSITE_INTERVAL_HOURS=24
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.example.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
