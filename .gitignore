# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
michess_env/
venv/
env/

# IDE settings
.idea/
.vscode/

# Environment variables and secrets
.env
.env.*
# Шаблоны без секретов — в репозитории
!.env.example

# Logs and databases
*.log
*.sqlite3

# OS generated files
.DS_Store
Thumbs.db

# Seed data
src/db/data/pgns/
*.pgn

# Engine binaries
bin/
*.exe

node_modules/
# Project snapshots
project_snapshot*.txt
data/pgns/

# Кэши и отчёты инструментов качества кода
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# Резервные копии БД (docker-compose.prod.yml, сервис backup)
backups/

# Конфиг MCP, который PyCharm генерирует на каждом хосте (порт свой)
.mcp.json

# Логи калибровки ботов — данные для пересчёта рейтингов (scripts/calibrate_bots.py --from-log/--reuse-log)
!scripts/calibration_runs/*.log

# Снимок проекта для ИИ-помощника (make_snapshot.py) — генерируется локально, в git не хранится.
# Сводка состояния — python make_snapshot.py --status (или _project_snapshot/STATUS.md после генерации).
_project_snapshot/
